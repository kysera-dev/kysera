{
  "name": "blog-app-example",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "description": "Blog application example using Kysera",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "migrate": "tsx src/db/migrate.ts",
    "seed": "tsx src/db/seed.ts"
  },
  "dependencies": {
    "@kysera/core": "workspace:*",
    "@kysera/debug": "workspace:*",
    "@kysera/infra": "workspace:*",
    "@kysera/repository": "workspace:*",
    "@kysera/soft-delete": "workspace:*",
    "kysely": "^0.29.4",
    "pg": "^8.22.0",
    "zod": "^4.4.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "tsx": "^4.23.1",
    "typescript": "^6.0.3"
  }
}
