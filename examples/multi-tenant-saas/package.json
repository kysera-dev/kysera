  },
  "dependencies": {
    "@kysera/core": "workspace:*",
    "@kysera/executor": "workspace:*",
    "@kysera/repository": "workspace:*",
    "@kysera/rls": "workspace:*",
    "@kysera/audit": "workspace:*",
    "@kysera/timestamps": "workspace:*",
    "@kysera/infra": "workspace:*",
    "@kysera/debug": "workspace:*",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "zod": "^4.4.3",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "tsx": "^4.23.12",
    "typescript": "^6.0.3"
  }
}
