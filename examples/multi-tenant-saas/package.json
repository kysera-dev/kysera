{
  "name": "multi-tenant-saas-example",
  "version": "0.10.0",
  "private": true,
  "type": "module",
  "description": "Multi-tenant SaaS application example using Kysera",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "migrate": "tsx src/db/migrate.ts",
