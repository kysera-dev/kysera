    "@kysera/infra": "workspace:*",
    "@kysera/debug": "workspace:*",
    "kysely": "^0.29.7",
    "pg": "^8.23.1",
    "zod": "^4.6.7",
    "dotenv": "^17.4.2"
  },
  "devDependencies": {
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3"
  }
