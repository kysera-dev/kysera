{
  "$schema": "https://turbo.build/schema.json",
  "remoteCache": {
    "enabled": false
  },
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**", "build/**"],
      "env": ["NODE_ENV"]
    },
    "dev": {
      "cache": false,
      "persistent": true
    },
    "test": {
      "dependsOn": ["build"],
      "env": ["NODE_ENV", "CI", "TEST_*", "POSTGRES_*", "MYSQL_*", "MSSQL_*", "DB_PORT"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:coverage": {
      "dependsOn": ["build"],
      "env": ["NODE_ENV", "CI", "TEST_*", "POSTGRES_*", "MYSQL_*", "MSSQL_*", "DB_PORT"],
      "outputs": ["coverage/**"],
      "cache": false
    },
    "test:multi-db": {
      "dependsOn": ["build"],
      "env": ["NODE_ENV", "CI", "TEST_*", "POSTGRES_*", "MYSQL_*", "MSSQL_*", "DB_PORT"],
      "cache": false
    },
    "lint": {
      "dependsOn": [],
      "outputs": []
    },
    "typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    }
  }
}
