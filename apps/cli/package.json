{
  "name": "@kysera/cli",
  "version": "0.10.0",
  "description": "Comprehensive CLI for Kysera data access toolkit",
  "type": "module",
  "bin": {
    "kysera": "./dist/index.js"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "templates",
    "scripts/completions"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:unit": "vitest run tests/unit",
    "test:integration": "vitest run tests/integration",
    "test:e2e": "vitest run tests/e2e",
    "test:watch": "vitest --watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "prepublishOnly": "pnpm run build && pnpm run test"
  },
  "keywords": [
    "kysera",
    "data-access",
    "cli",
    "database",
    "migrations",
    "kysely",
    "typescript"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysera-dev/kysera.git",
    "directory": "apps/cli"
  },
  "bugs": {
    "url": "https://github.com/kysera-dev/kysera/issues"
  },
  "homepage": "https://github.com/kysera-dev/kysera#readme",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "engines": {
    "node": ">=22.18.0",
    "bun": ">=1.0.0"
  },
  "dependencies": {
    "commander": "^15.0.0",
    "kysely": "^0.29.5",
    "zod": "^4.4.3",
    "dotenv": "^17.4.2",
    "cosmiconfig": "^9.0.2",
    "cosmiconfig-typescript-loader": "^6.3.0",
    "execa": "^10.0.1",
    "glob": "^13.0.6",
    "pg": "^8.23.0",
    "mysql2": "^3.24.2",
    "better-sqlite3": "^13.0.3",
    "@faker-js/faker": "^10.6.0",
    "js-yaml": "^5.4.1",
    "@kysera/core": "workspace:*",
    "@kysera/dialects": "workspace:*",
    "@kysera/repository": "workspace:*",
    "@kysera/migrations": "workspace:*",
    "@kysera/audit": "workspace:*",
    "@kysera/rls": "workspace:*",
    "@kysera/soft-delete": "workspace:*",
    "@kysera/timestamps": "workspace:*",
    "@kysera/infra": "workspace:*",
    "@kysera/debug": "workspace:*",
    "@kysera/testing": "workspace:*",
    "@xec-sh/kit": "^0.11.1"
  },
  "devDependencies": {
    "@types/node": "^26.4.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6"
  },
  "sideEffects": false
}
