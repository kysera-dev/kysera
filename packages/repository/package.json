{
  "name": "@kysera/repository",
  "version": "0.10.0",
  "description": "Repository pattern implementation for Kysely with smart validation",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vitest run --typecheck.only --typecheck.ignoreSourceErrors",
    "test:coverage": "vitest run --coverage",
    "test:multi-db": "vitest run test/multi-db.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "peerDependencies": {
    "kysely": ">=0.29.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "zod": {
      "optional": true
    }
  },
  "dependencies": {
    "@kysera/core": "workspace:*",
    "@kysera/dal": "workspace:*",
    "@kysera/executor": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.4",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.4",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "tsup": "^8.5.1",
    "tsx": "^4.23.9",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "keywords": [
    "kysely",
    "data-access",
    "repository",
    "pattern",
    "validation",
    "typescript"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysera-dev/kysera.git",
    "directory": "packages/repository"
  },
  "bugs": {
    "url": "https://github.com/kysera-dev/kysera/issues"
  },
  "homepage": "https://github.com/kysera-dev/kysera#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  }
}
