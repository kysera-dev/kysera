{
  "name": "@kysera/migrations",
  "version": "0.10.0",
  "description": "Database migration management for Kysely with dry-run support and flexible rollback capabilities",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schemas": {
      "types": "./dist/schemas.d.ts",
      "import": "./dist/schemas.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:multi-db": "TEST_POSTGRES=true vitest run test/advisory-lock.integration.test.ts test/advisory-lock.mssql.integration.test.ts"
  },
  "keywords": [
    "kysely",
    "data-access",
    "migrations",
    "database",
    "typescript",
    "kysera"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "dependencies": {
    "@kysera/core": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.5",
    "pg": "^8.23.0",
    "tarn": "^3.1.2",
    "tedious": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "kysely": ">=0.29.0",
    "zod": "^4.3.6"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysera-dev/kysera.git",
    "directory": "packages/migrations"
  },
  "bugs": {
    "url": "https://github.com/kysera-dev/kysera/issues"
  },
  "homepage": "https://github.com/kysera-dev/kysera#readme"
}
