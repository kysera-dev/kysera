{
  "name": "@kysera/testing",
  "version": "0.10.0",
  "description": "Testing utilities for Kysely - transaction isolation, factories, seeding",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-node-imports.cjs ./dist net fs os path",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kysera/core": "workspace:*"
  },
  "peerDependencies": {
    "kysely": ">=0.29.0",
    "@kysera/executor": "workspace:*",
    "better-sqlite3": ">=9.0.0"
  },
  "peerDependenciesMeta": {
    "@kysera/executor": {
      "optional": true
    },
    "better-sqlite3": {
      "optional": true
    }
  },
  "devDependencies": {
    "@kysera/executor": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "kysely",
    "data-access",
    "database",
    "testing",
    "transaction",
    "factory",
    "seeding"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysera-dev/kysera.git",
    "directory": "packages/testing"
  },
  "bugs": {
    "url": "https://github.com/kysera-dev/kysera/issues"
  },
  "homepage": "https://github.com/kysera-dev/kysera#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  }
}
