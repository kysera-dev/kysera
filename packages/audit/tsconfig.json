{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "rootDir": "../..",
    "outDir": "./dist",
    "composite": true,
    "types": ["vitest/globals", "node"],
    "skipLibCheck": true
  },
  "include": [
    "src/**/*",
    "test/**/*",
    "*.config.ts",
    "../executor/src/**/*",
    "../repository/src/**/*",
    "../soft-delete/src/**/*",
    "../core/src/**/*",
    "../testing/src/detection.ts"
  ],
  "exclude": ["node_modules", "dist"]
}
