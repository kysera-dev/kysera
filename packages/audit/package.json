{
  "name": "@kysera/audit",
  "version": "0.10.0",
  "description": "Audit logging plugin for Kysely repositories",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:multi-db": "vitest run test/multi-db.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\""
  },
  "dependencies": {
    "@kysera/core": "workspace:*"
  },
  "devDependencies": {
    "@kysera/repository": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@vitest/coverage-v8": "^4.1.11",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.5",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.11",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@kysera/executor": "workspace:*",
    "@kysera/repository": "workspace:*",
    "kysely": ">=0.29.0",
    "zod": "^4.3.6"
  },
  "peerDependenciesMeta": {
    "@kysera/repository": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysera-dev/kysera.git",
    "directory": "packages/audit"
  },
  "keywords": [
    "kysely",
    "data-access",
    "typescript",
    "audit",
    "logging",
    "tracking"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "sideEffects": false
}
