{
  "name": "@kysera/core",
  "version": "0.10.0",
  "description": "Core utilities for Kysely - errors, pagination, types, logger",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./cursor-crypto": {
      "types": "./dist/cursor-crypto.d.ts",
      "import": "./dist/cursor-crypto.js"
    },
    "./eslint": {
      "import": "./src/eslint/vertical-slice.config.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup && node ../../scripts/fix-node-imports.cjs ./dist crypto",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:types": "vitest run --typecheck.only --typecheck.ignoreSourceErrors",
    "test:coverage": "vitest run --coverage",
    "test:multi-db": "vitest run test/multi-db.test.ts",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "dependencies": {
    "@kysera/executor": "workspace:*"
  },
  "peerDependencies": {
    "kysely": ">=0.29.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.2.0",
    "@types/pg": "^8.21.0",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.3",
    "kysely": "^0.29.5",
    "mysql2": "^3.23.3",
    "pg": "^8.23.0",
    "tarn": "^3.1.2",
    "tedious": "^20.0.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "kysely",
    "data-access",
    "database",
    "typescript",
    "sql",
    "postgres",
    "mysql",
    "sqlite"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysera-dev/kysera.git",
    "directory": "packages/core"
  },
  "bugs": {
    "url": "https://github.com/kysera-dev/kysera/issues"
  },
  "homepage": "https://github.com/kysera-dev/kysera#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  }
}
