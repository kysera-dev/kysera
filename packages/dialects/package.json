{
  "name": "@kysera/dialects",
  "version": "0.8.8",
  "description": "Dialect-specific utilities for Kysely - PostgreSQL, MySQL, SQLite support",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint .",
    "test:multi-db": "TEST_POSTGRES=true TEST_MYSQL=true vitest run test/multi-db.integration.test.ts"
  },
  "peerDependencies": {
    "kysely": ">=0.29.0"
  },
  "dependencies": {
    "@kysera/core": "workspace:*"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.2",
    "kysely": "^0.29.4",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10"
  },
  "keywords": [
    "kysely",
    "dialect",
    "postgres",
    "mysql",
    "sqlite",
    "database",
    "sql"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/kysera-dev/kysera.git",
    "directory": "packages/dialects"
  },
  "bugs": {
    "url": "https://github.com/kysera-dev/kysera/issues"
  },
  "homepage": "https://github.com/kysera-dev/kysera#readme",
  "publishConfig": {
    "access": "public"
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  }
}
