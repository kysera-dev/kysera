{
  "name": "@kysera/timestamps",
  "version": "0.9.0",
  "description": "Automatic timestamp management plugin for Kysely repositories",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./schema": {
      "types": "./dist/schema.d.ts",
      "import": "./dist/schema.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "typecheck": "tsc --noEmit",
    "lint": "eslint ."
  },
  "keywords": [
    "kysely",
    "data-access",
    "timestamps",
    "created_at",
    "updated_at",
    "plugin",
    "typescript"
  ],
  "author": "Kysera Team",
  "license": "MIT",
  "dependencies": {
    "@kysera/core": "workspace:*"
  },
  "devDependencies": {
    "@kysera/repository": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@vitest/coverage-v8": "^4.1.10",
    "better-sqlite3": "^13.0.2",
    "kysely": "^0.29.4",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  },
  "peerDependencies": {
    "@kysera/repository": "workspace:*",
    "kysely": ">=0.29.0",
    "zod": "^4.3.6",
    "@kysera/executor": "workspace:*"
  },
  "peerDependenciesMeta": {
    "@kysera/repository": {
      "optional": true
    },
    "zod": {
      "optional": true
    }
  },
  "sideEffects": false,
  "engines": {
    "node": ">=22.0.0",
    "bun": ">=1.0.0"
  }
}
