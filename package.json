{
  "name": "kysera",
  "version": "0.9.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@10.25.0",
  "description": "Type-safe data access toolkit for TypeScript built on Kysely",
  "scripts": {
    "dev": "turbo run dev",
    "build": "turbo run build",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:multi-db": "turbo run test:multi-db --concurrency=1",
    "test:types": "pnpm -r --if-present run test:types",
    "test:docker": "tsx scripts/test-with-docker.ts",
    "bench": "pnpm --filter @kysera/bench bench",
    "docker:up": "docker compose -f docker-compose.test.yml up -d",
    "docker:down": "docker compose -f docker-compose.test.yml down -v",
    "lint": "turbo run lint",
    "lint:fix": "eslint . --fix",
    "typecheck": "turbo run typecheck",
    "format": "prettier --write \"**/*.{ts,tsx,js,jsx,json,md}\"",
    "fix:all": "pnpm lint:fix && pnpm format",
    "docs": "typedoc",
    "docs:serve": "pnpm docs && npx http-server docs/api -p 8080 -o",
    "docs:check-snippets": "tsx scripts/check-doc-snippets.ts",
    "release": "tsx scripts/release.ts",
    "release:dry": "tsx scripts/release.ts --dry-run",
    "release:ci": "tsx scripts/release.ts --skip-tests --force",
    "postinstall": "pnpm rebuild better-sqlite3 2>/dev/null || true"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@swc/core": "^1.15.47",
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^26.1.2",
    "@types/pg": "^8.20.3",
    "@types/semver": "^7.7.1",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@xec-sh/kit": "^0.9.0",
    "better-sqlite3": "^13.0.2",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-promise": "^7.3.0",
    "eslint-plugin-sonarjs": "^4.2.0",
    "eslint-plugin-unicorn": "^72.0.0",
    "glob": "^13.0.6",
    "kysely": "^0.29.4",
    "mysql2": "^3.23.2",
    "pg": "^8.22.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "tsx": "^4.23.1",
    "turbo": "^2.10.8",
    "typedoc": "^0.28.20",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.65.0"
  },
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  }
}
